# ---- Model storage -----------------------------------------------------------
# Existing Ollama data dir, mounted at /root/.ollama in the container.
# Holds the 17 GB of weights you already downloaded. Do not chown it.
OLLAMA_MODELS_DIR=/home/mehmet/ollama_models

# ---- Networking --------------------------------------------------------------
# 127.0.0.1 = reachable from this machine and from Windows via WSL2 port
# forwarding, but not from the LAN. Use 0.0.0.0 to expose to other devices.
BIND_ADDR=127.0.0.1
WEBUI_BIND_ADDR=127.0.0.1
OLLAMA_PORT=11434
WEBUI_PORT=3000

# Persist CPU-only mode for every `make` target (Compose reads COMPOSE_FILE
# from this file). Leave commented to use the GPU.
# COMPOSE_FILE=compose.yaml:compose.cpu.yaml

# ---- Image tags --------------------------------------------------------------
OLLAMA_TAG=latest
OPEN_WEBUI_TAG=v0.11.1

# ---- Runtime tuning (RTX 4060 Laptop, 8 GB VRAM) -----------------------------
# How long a model stays resident in VRAM after its last request.
OLLAMA_KEEP_ALIVE=5m
# 8 GB fits one mid-size model comfortably; >1 invites eviction thrash.
OLLAMA_MAX_LOADED_MODELS=1
# Default context when the request doesn't specify one. Raising this raises
# VRAM use per loaded model.
OLLAMA_CONTEXT_LENGTH=8192

# ---- Open WebUI --------------------------------------------------------------
# True: first account created becomes admin (required to pull models from the
# UI). False: no login at all, single shared session.
WEBUI_AUTH=True
